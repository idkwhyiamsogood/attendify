uc1->trans[label="«include»",style=dashed];uc2->opening[label="«include»",style=dashed];correction->uc1[label="«extend»",style=dashed];correction->uc2[label="«extend»",style=dashed];manual->uc3[label="«extend»",style=dashed];csv->uc3[label="«extend»",style=dashed];reset->uc4[label="«extend»",style=dashed];}
