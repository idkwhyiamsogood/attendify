student[label="«actor»\nСтудент",shape=plaintext];teacher[label="«actor»\nПреподаватель",shape=plaintext];curator[label="«actor»\nКлассный руководитель",shape=plaintext];admin[label="«actor»\nАдминистратор",shape=plaintext];sdk[label="«external»\nSDK ближней связи",shape=plaintext];
